{
  "name": "@strumble/relay",
  "version": "0.1.0",
  "private": true,
  "description": "Local couch-link relay (rooms, routing, presence, time sync) for development and self-hosting.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules",
    "fake-tv": "tsx src/fake-tv.ts",
    "fake-phone": "tsx src/fake-phone.ts"
  },
  "dependencies": {
    "@strumble/crowd": "workspace:*",
    "couch-link": "workspace:*",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
