{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeEncoreMc",
      "Effect": "Allow",
      "Action": ["bedrock-agentcore:InvokeAgentRuntime", "bedrock-agentcore:StopRuntimeSession"],
      "Resource": [
        "arn:aws:bedrock-agentcore:ap-south-1:911167912118:runtime/encore_mc-*",
        "arn:aws:bedrock-agentcore:ap-south-1:911167912118:runtime/encore_mc-*/runtime-endpoint/*"
      ]
    },
    {
      "Sid": "NoUserIdDelegation",
      "Effect": "Deny",
      "Action": "bedrock-agentcore:InvokeAgentRuntimeForUser",
      "Resource": "arn:aws:bedrock-agentcore:*:911167912118:runtime/*"
    }
  ]
}
